a:["$","p",null,{"children":"One round of bingo takes about 10-20 minutes. Plan for 2-3 rounds with escalating challenges:"}]
b:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Round 1:"}]," Complete any single line (easiest, good warmup)"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Round 2:"}]," Complete an X pattern or four corners"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Round 3:"}]," Full blackout — cover every square (hardest, biggest prize)"]}]]}]
c:["$","h2",null,{"children":"Advanced Tips for Maximum Fun"}]
d:["$","h3",null,{"children":"Theme Your Cards"}]
e:["$","p",null,{"children":"Match your bingo cards to the party theme. Birthday? Use birthday-themed squares. Game night? Use board game references. The more personalized, the more laughs."}]
f:["$","h3",null,{"children":"Use Fun Markers"}]
10:["$","p",null,{"children":"Instead of pens, use candy (M&Ms, Skittles), small stickers, or stamps. Players can eat their markers after the game!"}]
11:["$","h3",null,{"children":"Add a Soundtrack"}]
12:["$","p",null,{"children":"Play upbeat background music during the game. It creates atmosphere and fills the pauses between calls. Lower the volume when calling items."}]
13:["$","h3",null,{"children":"Photo Opportunities"}]
14:["$","p",null,{"children":"Announce each winner dramatically. Take a photo of them holding their winning card. These make great party memories and social media posts."}]
15:["$","h2",null,{"children":"Party Bingo Ideas by Occasion"}]
16:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Birthday Party:"}]," \"Birthday person blows out candles,\" \"someone sings off-key,\" \"a gift gets re-gifted\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"Game Night:"}]," \"Someone accuses another of cheating,\" \"a rule gets looked up,\" \"someone flips the board\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"Dinner Party:"}]," \"Host refills wine,\" \"someone compliments the food,\" \"a recipe is requested\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"BBQ/Cookout:"}]," \"Burger is well done,\" \"someone gets sunburned,\" \"a kid finds a bug\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"New Year's:"}]," \"Someone makes a resolution,\" \"midnight countdown,\" \"someone falls asleep before midnight\""]}]]}]
