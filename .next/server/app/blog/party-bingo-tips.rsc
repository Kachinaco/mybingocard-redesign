13:["$","li",null,{"children":[["$","strong",null,{"children":"Mystery bags"}]," — Wrapped random items create excitement and laughs"]}]
14:["$","h2",null,{"children":"During the Game: Execution"}]
15:["$","h3",null,{"children":"The Rules Announcement (Keep It Short)"}]
16:["$","p",null,{"children":"Spend no more than 30 seconds explaining rules. Most people know bingo, so keep it brief: \"Mark squares when you see or hear the item. Complete a line in any direction — horizontal, vertical, or diagonal — and yell BINGO! First confirmed bingo wins the prize. Let's play!\""}]
17:["$","h3",null,{"children":"The Caller (If Using One)"}]
18:["$","p",null,{"children":"The caller sets the energy. Tips for great calling:"}]
19:["$","ul",null,{"children":[["$","li",null,{"children":"Speak clearly and loudly — repeat each item twice"}],["$","li",null,{"children":"Pause 10-15 seconds between calls to let people scan"}],["$","li",null,{"children":"Build tension: \"The next item is... (pause)... CAKE TIME!\""}],["$","li",null,{"children":"Comment on the game: \"That's a rare one — who has it?\""}]]}]
1a:["$","h3",null,{"children":"Verification"}]
1b:["$","p",null,{"children":"When someone yells BINGO, verify their card. Read back their marked items to confirm they're all valid. If it's a false alarm, play continues. This takes 30 seconds and prevents disputes."}]
1c:["$","h3",null,{"children":"Multiple Rounds"}]
1d:["$","p",null,{"children":"One round of bingo takes about 10-20 minutes. Plan for 2-3 rounds with escalating challenges:"}]
1e:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Round 1:"}]," Complete any single line (easiest, good warmup)"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Round 2:"}]," Complete an X pattern or four corners"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Round 3:"}]," Full blackout — cover every square (hardest, biggest prize)"]}]]}]
1f:["$","h2",null,{"children":"Advanced Tips for Maximum Fun"}]
20:["$","h3",null,{"children":"Theme Your Cards"}]
21:["$","p",null,{"children":"Match your bingo cards to the party theme. Birthday? Use birthday-themed squares. Game night? Use board game references. The more personalized, the more laughs."}]
22:["$","h3",null,{"children":"Use Fun Markers"}]
23:["$","p",null,{"children":"Instead of pens, use candy (M&Ms, Skittles), small stickers, or stamps. Players can eat their markers after the game!"}]
24:["$","h3",null,{"children":"Add a Soundtrack"}]
25:["$","p",null,{"children":"Play upbeat background music during the game. It creates atmosphere and fills the pauses between calls. Lower the volume when calling items."}]
26:["$","h3",null,{"children":"Photo Opportunities"}]
27:["$","p",null,{"children":"Announce each winner dramatically. Take a photo of them holding their winning card. These make great party memories and social media posts."}]
28:["$","h2",null,{"children":"Party Bingo Ideas by Occasion"}]
29:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Birthday Party:"}]," \"Birthday person blows out candles,\" \"someone sings off-key,\" \"a gift gets re-gifted\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"Game Night:"}]," \"Someone accuses another of cheating,\" \"a rule gets looked up,\" \"someone flips the board\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"Dinner Party:"}]," \"Host refills wine,\" \"someone compliments the food,\" \"a recipe is requested\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"BBQ/Cookout:"}]," \"Burger is well done,\" \"someone gets sunburned,\" \"a kid finds a bug\""]}],["$","li",null,{"children":[["$","strong",null,{"children":"New Year's:"}]," \"Someone makes a resolution,\" \"midnight countdown,\" \"someone falls asleep before midnight\""]}]]}]
