1a:["$","p",null,{"children":["Print one card per guest. Place them at each seat with a small pen or marker. Use our ",["$","$L9",null,{"href":"/wedding-bingo","children":"free wedding bingo card generator"}]," to create beautiful cards that match your wedding colors. Each card is uniquely shuffled automatically."]}]
1b:["$","h3",null,{"children":"Timing"}]
1c:["$","p",null,{"children":"Place cards out before guests arrive. The game runs passively throughout the entire reception — during cocktail hour, dinner, speeches, and dancing. Announce a deadline (like \"before the last dance\") for winners to claim prizes."}]
1d:["$","h3",null,{"children":"Prizes"}]
1e:["$","p",null,{"children":"Keep prizes simple but meaningful:"}]
1f:["$","ul",null,{"children":[["$","li",null,{"children":"A table centerpiece (guests love taking these home!)"}],["$","li",null,{"children":"A bottle of wine from the bar"}],["$","li",null,{"children":"A gift card to a local restaurant"}],["$","li",null,{"children":"A special dance with the bride or groom"}],["$","li",null,{"children":"First in line at the dessert table"}]]}]
20:["$","h2",null,{"children":"Wedding Bingo FAQ"}]
21:["$","h3",null,{"children":"How many cards should I print?"}]
22:["$","p",null,{"children":"Print one per guest plus 10-15 extras. Some guests will want to play multiple cards, and others might join late."}]
23:["$","h3",null,{"children":"When should guests play?"}]
24:["$","p",null,{"children":"Wedding bingo works best as a passive game. Place cards at seats and let guests play throughout the reception."}]
25:["$","h3",null,{"children":"Can kids play too?"}]
26:["$","p",null,{"children":"Absolutely! Wedding bingo is one of the few reception activities that kids genuinely enjoy. They love spotting the moments and racing to mark their cards."}]
27:["$","h2",null,{"children":"Create Your Wedding Bingo Cards"}]
28:["$","p",null,{"children":["Ready to add wedding bingo to your reception? Our ",["$","$L9",null,{"href":"/wedding-bingo","children":"free wedding bingo card generator"}]," creates elegant, print-ready cards that match your wedding style. Each card is unique, and you can generate as many as you need in seconds."]}]
