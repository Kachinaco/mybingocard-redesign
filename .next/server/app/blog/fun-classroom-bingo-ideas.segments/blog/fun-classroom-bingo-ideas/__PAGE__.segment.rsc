a:["$","h3",null,{"children":"11. State Capital Bingo"}]
b:["$","p",null,{"children":"Feature state names on cards, call out capitals (or vice versa). Cover the whole country or focus on a specific region. Students learn geography while competing with classmates."}]
c:["$","h3",null,{"children":"12. Historical Figure Bingo"}]
d:["$","p",null,{"children":"Cards show names of historical figures. Call out achievements or clues — \"first president of the United States,\" \"wrote the Declaration of Independence.\" Perfect for unit reviews."}]
e:["$","h2",null,{"children":"Fun & Seasonal"}]
f:["$","h3",null,{"children":"13. Back-to-School Bingo"}]
10:["$","p",null,{"children":"An icebreaker game for the first week. Cards feature \"find someone who...\" statements — \"has a pet dog,\" \"traveled this summer,\" \"speaks two languages.\" Students mingle to find matches and mark their cards."}]
11:["$","h3",null,{"children":"14. End-of-Year Bingo"}]
12:["$","p",null,{"children":"Feature memorable moments from the school year. Students mark squares as the class discusses shared experiences. A nostalgic and fun way to close out the year."}]
13:["$","h3",null,{"children":"15. Holiday Bingo"}]
14:["$","p",null,{"children":"Seasonal bingo cards for Halloween, Thanksgiving, winter holidays, Valentine's Day, and more. A low-prep, high-engagement activity for the days before any school break."}]
15:["$","h2",null,{"children":"Classroom Bingo Pro Tips for Teachers"}]
16:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Laminate cards"}]," — Print once, use all year with dry-erase markers"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Use small prizes"}]," — Stickers, homework passes, or extra recess minutes"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Vary the winning pattern"}]," — Line, four corners, X-shape, blackout"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Let students be the caller"}]," — Takes the pressure off you and builds confidence"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Time it"}]," — Set a 15-minute timer to keep energy high and pace fast"]}]]}]
