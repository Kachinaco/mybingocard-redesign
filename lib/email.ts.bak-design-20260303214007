export async function sendSubscriptionCanceledEmail(
  to: string,
  name: string,
  currentPeriodEnd?: Date | null
): Promise<boolean> {
  const firstName = escapeHtml(getFirstName(name));
  const subject = "Your MyBingoCard subscription was canceled";
  const renewalText = currentPeriodEnd
    ? `You'll keep access through ${formatDate(currentPeriodEnd)}.`
    : "Your subscription has been canceled.";

  return sendEmail({
    to,
    subject,
    html: `
      <div style="font-family:Arial,sans-serif;max-width:640px;margin:0 auto;padding:24px;color:#111827;line-height:1.5;">
        <h1 style="margin:0 0 12px;font-size:26px;">Subscription canceled</h1>
