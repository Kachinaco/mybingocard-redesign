  try {
    await transporter.sendMail({
      from: process.env.EMAIL_FROM || "MyBingoCard <noreply@mybingocard.com>",
      to,
      subject: "Welcome to MyBingoCard!",
      html: `
<!DOCTYPE html>
<html>
